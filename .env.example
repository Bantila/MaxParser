# Скопируйте этот файл в .env и заполните. 

# Телефон аккаунта Max, с которого читаем школьный чат.
# При первом запуске придёт SMS-код, дальше сессия лежит в cache/max.db.
MAX_PHONE=

# Пароль двухфакторной аутентификации Max.
# Max не пускает сторонние клиенты без 2FA — включите её в приложении:
# Настройки -> Безопасность -> Пароль для входа (нужно чтобы вы были залогинены на устройстве больше 24 часов иначе хрен).
# Если оставить пустым, пароль будет спрошен в консоли при запуске
# (в контейнере в фоновом режиме это не сработает).
MAX_PASSWORD=

# ID школьного чата в Max. Узнать: python bridge.py chats
# Пусто = пересылать вообще все чаты (обычно не то, что нужно).
MAX_CHAT_ID=

# Токен Telegram-бота от @BotFather.
TG_TOKEN=

# Прокси для Telegram. С российских адресов api.telegram.org обычно
# недоступен - в логах будет httpx.ConnectTimeout. Проверить с сервера:
#   curl -sI --max-time 10 https://api.telegram.org
# Формат: socks5://user:pass@host:port или http://host:port
# Через прокси идёт только Telegram, Max - напрямую, ему нужен российский IP.
# С юнитом deploy/maxparser-tunnel.service значение будет таким:
#   TG_PROXY=socks5://127.0.0.1:21080
TG_PROXY=

# Куда пересылать сообщения из Max, через запятую. Узнать свой ID: @userinfobot.
# Если пересылка нужна только в группу, оставьте пусто и заполните TG_GROUP,
# иначе сообщения будут приходить и в группу, и вам в личку.
# Ответы на команды бота приходят в личку в любом случае.
TG_TARGETS=

# --- Группа класса с темами (необязательно) --------------------------------
# ID группы. Если группа указана здесь, НЕ дублируйте её в TG_TARGETS,
# иначе каждое сообщение придёт дважды.
TG_GROUP=

# 1 - в группе включены темы, раскладывать сообщения по ним
# 0 - тем нет, всё льётся в группу одним потоком
TG_TOPICS=0

# Номера тем. Пусто или 0 - в эту тему не слать.
# Узнать номер: откройте тему, на любом сообщении в ней "Копировать ссылку",
# получится t.me/c/2582.../3/12 - номер темы это предпоследнее число (3).
# Для General ставьте 1: туда пишут без указания темы, мост это учитывает.
TG_TOPIC_TEXT=
TG_TOPIC_PHOTO=
TG_TOPIC_FILE=

# Тема, куда падает вообще всё, включая то, что ушло в темы выше.
TG_TOPIC_ALL=

# Кому разрешено писать в Max через бота.
# ПЕРВЫМ укажите свой ID — его сообщения уходят без подписи,
# остальные уходят с префиксом "Имя: ", потому что аккаунт Max ваш.
# Пускайте сюда только тех, за чьи слова готовы отвечать лично.
TG_TRUSTED=

# 1 - писать в лог каждый сырой кадр от сервера Max. Нужно только для
# отладки: видно, приходят ли события вообще.
RAW_LOG=0

# true  - только читаем Max, ничего не отправляем (начните с этого)
# false - включена отправка из Telegram в Max
READ_ONLY=true
