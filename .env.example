# Скопируйте этот файл в .env и заполните. .env в git не попадает.

# Телефон аккаунта Max, с которого читаем школьный чат.
# При первом запуске придёт SMS-код, дальше сессия лежит в cache/max.db.
MAX_PHONE=+79990000000

# ID школьного чата в Max. Узнать: python bridge.py chats
# Пусто = пересылать вообще все чаты (обычно не то, что нужно).
MAX_CHAT_ID=

# Токен Telegram-бота от @BotFather.
TG_TOKEN=

# Куда пересылать сообщения из Max: ваш личный chat_id и/или ID группы класса.
# Через запятую. ID группы отрицательный. Узнать свой ID: @userinfobot.
TG_TARGETS=

# Кому разрешено писать в Max через бота.
# ПЕРВЫМ укажите свой ID — его сообщения уходят без подписи,
# остальные уходят с префиксом "Имя: ", потому что аккаунт Max ваш.
# Пускайте сюда только тех, за чьи слова готовы отвечать лично.
TG_TRUSTED=

# true  - только читаем Max, ничего не отправляем (начните с этого)
# false - включена отправка из Telegram в Max
READ_ONLY=true
